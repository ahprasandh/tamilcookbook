---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'calendar' | 'planner' | 'menu' | 'recipes' | 'shopping' | 'admin' | 'about';
}

const { title = 'தமிழ் சமையல்', description = 'Plan Tamil South Indian meals monthly. Browse recipes, plan weekly menus, and generate shopping lists.', active = 'calendar' } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const navItems = [
  { key: 'calendar', icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>', label: 'Calendar', href: `${base}` },
  { key: 'planner', icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>', label: 'Planner', href: `${base}planner/` },
  { key: 'menu', icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>', label: 'Menu', href: `${base}menu/` },
  { key: 'recipes', icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>', label: 'Recipes', href: `${base}recipes/` },
  { key: 'shopping', icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>', label: 'Shopping', href: `${base}shopping/` },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${base}logo.svg`} />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,500;0,9..40,700;0,9..40,800&family=Noto+Sans+Tamil:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-cream">
  {/* Desktop Nav */}
  <nav class="hidden md:flex items-center bg-cream border-b border-mist px-8 h-14 sticky top-0 z-50">
    <a href={`${base}`} class="font-heading font-extrabold text-lg text-bark mr-10 tracking-tight no-underline flex items-center gap-2">
      <img src={`${base}logo.svg`} alt="" class="w-12 h-12" /> <span class="relative -top-0.5">தமிழ் சமையல்</span>
    </a>
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'px-5 py-4 text-sm font-semibold no-underline transition-colors duration-150',
          active === item.key
            ? 'text-turmeric border-b-[2.5px] border-turmeric'
            : 'text-stone hover:text-bark border-b-[2.5px] border-transparent',
        ]}
        aria-current={active === item.key ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  {/* Main Content */}
  <main class="pb-20 md:pb-0">
    <slot />
  </main>

  {/* Mobile Bottom Nav */}
  <nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-mist flex justify-around items-center h-14 pb-[env(safe-area-inset-bottom)]">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'flex flex-col items-center gap-0.5 no-underline text-[10px] font-medium',
          active === item.key
            ? 'text-turmeric font-bold opacity-100'
            : 'text-bark opacity-50',
        ]}
        aria-current={active === item.key ? 'page' : undefined}
      >
        <span set:html={item.icon} />
        {item.label}
      </a>
    ))}
  </nav>
</body>
</html>
