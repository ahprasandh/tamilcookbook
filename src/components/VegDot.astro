---
interface Props {
  veg: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const { veg, size = 'md' } = Astro.props;
const sizeMap = { sm: 'w-3 h-3', md: 'w-3.5 h-3.5', lg: 'w-[18px] h-[18px]' };
const dotSize = { sm: 'w-1.5 h-1.5', md: 'w-2 h-2', lg: 'w-2.5 h-2.5' };
const color = veg ? 'border-leaf' : 'border-clay';
const fill = veg ? 'bg-leaf' : 'bg-clay';
---
<span
  class:list={['inline-flex items-center justify-center border-2 rounded-sm', sizeMap[size], color]}
  title={veg ? 'Vegetarian' : 'Non-vegetarian'}
  role="img"
  aria-label={veg ? 'Vegetarian' : 'Non-vegetarian'}
>
  <span class:list={['rounded-full', dotSize[size], fill]}></span>
</span>
