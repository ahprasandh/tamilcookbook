---
import BaseLayout from '../../layouts/BaseLayout.astro';
import recipes from '../../data/recipes.js';
import foods, { getFoodsByCategory } from '../../data/foods.js';
import plannerJson from '../../data/planner.json';

const recipeMap = {};
recipes.forEach((r) => {
  recipeMap[r.id] = { id: r.id, name_en: r.name_en, name_ta: r.name_ta, category: r.category, veg: r.veg };
});
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const tiffinFoods = getFoodsByCategory('tiffin');
const lunchFoods = getFoodsByCategory('lunch');
const extrasFoods = getFoodsByCategory('extras');
---
<BaseLayout title="Planner — Tamil Cookbook" active="planner">
  <div id="planner-container" class="max-w-7xl mx-auto px-4 md:px-6 py-3">
    {/* Week Header */}
    <div id="week-header" class="hidden flex items-center justify-between mb-2">
      <div id="week-nav" class="flex items-center gap-3">
        <button id="prev-week" class="text-stone hover:text-bark cursor-pointer p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <h1 id="week-title" class="text-lg md:text-xl font-extrabold text-bark"></h1>
        <button id="next-week" class="text-stone hover:text-bark cursor-pointer p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
      <div id="week-actions" class="flex items-center gap-2">
        <button id="export-planner" class="hidden rounded-md bg-leaf text-white text-xs font-semibold px-3 py-1.5 cursor-pointer hover:opacity-90 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V3m0 0l-4 4m4-4l4 4M2 17l.621 2.485A2 2 0 004.561 21h14.878a2 2 0 001.94-1.515L22 17"/></svg>
          Save
        </button>
        <button id="auto-assign-btn" class="rounded-md bg-turmeric text-white text-xs font-semibold px-3 py-1.5 cursor-pointer hover:opacity-90 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Auto-fill
        </button>
        <button id="today-btn" class="rounded-md bg-sand text-bark text-xs font-semibold px-3 py-1.5 cursor-pointer hover:bg-mist">This week</button>
        <button id="clear-week-btn" class="rounded-md bg-red-50 text-red-600 text-xs font-semibold px-3 py-1.5 cursor-pointer hover:bg-red-100 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Clear week
        </button>
      </div>
    </div>

    {/* Two Column Layout */}
    <div id="planner-layout" class="hidden grid grid-cols-1 md:grid-cols-[280px_1fr] gap-3">
      {/* LEFT: Suggestions Panel */}
      <div id="suggestions-panel" class="order-2 md:order-1">
        {/* Toggle: Tiffin / Lunch */}
        <div id="tab-switcher" class="flex rounded-lg bg-sand p-1 mb-2">
          <button id="tab-tiffin" class="flex-1 rounded-md text-xs font-bold py-2 cursor-pointer bg-white text-bark shadow-sm">Tiffin</button>
          <button id="tab-lunch" class="flex-1 rounded-md text-xs font-bold py-2 cursor-pointer text-stone">Lunch</button>
          <button id="tab-extras" class="flex-1 rounded-md text-xs font-bold py-2 cursor-pointer text-stone">Extras</button>
        </div>

        {/* Cook history */}
        <div id="rotation-info" class="text-[10px] text-stone mb-1.5 px-1"></div>

        {/* Filter */}
        <div id="combo-filter-wrap" class="relative mb-2">
          <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-stone pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          <input id="combo-filter" type="text" placeholder="Filter by dish name…" class="w-full rounded-md border border-mist bg-white pl-8 pr-3 py-1.5 text-xs text-bark placeholder:text-stone/50 focus:outline-none focus:border-turmeric" />
        </div>

        {/* Food combo list — draggable items */}
        <div id="combo-list" class="space-y-1.5 max-h-[calc(100vh-260px)] overflow-y-auto pr-1"></div>
      </div>

      {/* RIGHT: Week Days */}
      <div id="week-panel" class="order-1 md:order-2 overflow-x-auto">
        <table id="week-grid" class="w-full table-fixed border-collapse"></table>
      </div>
    </div>

    {/* Toast */}
    <div id="toast" class="hidden fixed top-6 left-1/2 -translate-x-1/2 bg-bark text-white rounded-lg px-5 py-2.5 text-sm font-semibold shadow-xl z-50 transition-all duration-300 opacity-0"></div>

    {/* Loading overlay */}
    <div id="planner-loading" class="text-center py-16">
      <div class="inline-block w-6 h-6 border-2 border-mist border-t-leaf rounded-full animate-spin mb-2"></div>
      <p class="text-stone text-sm">Loading planner...</p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .drop-zone.drag-over {
    background-color: rgba(232, 163, 23, 0.15) !important;
    border-color: #E8A317 !important;
    border-style: solid !important;
    box-shadow: inset 0 0 0 2px rgba(232, 163, 23, 0.3) !important;
  }
  .drop-zone.drag-over-lunch {
    background-color: rgba(45, 122, 58, 0.15) !important;
    border-color: #2D7A3A !important;
    border-style: solid !important;
    box-shadow: inset 0 0 0 2px rgba(45, 122, 58, 0.3) !important;
  }
  .combo-drag-item.dragging {
    opacity: 0.4;
  }
  .assigned-drag.dragging {
    opacity: 0.4;
  }
  /* Highlight all valid drop zones while dragging */
  body.dragging-tiffin .drop-zone[data-meal="breakfast"],
  body.dragging-tiffin .drop-zone[data-meal="dinner"] {
    border-color: #E8A317 !important;
    border-style: dashed !important;
    background-color: rgba(232, 163, 23, 0.08) !important;
    animation: pulse-tiffin 1.2s ease-in-out infinite;
  }
  body.dragging-lunch .drop-zone[data-meal="lunch"] {
    border-color: #2D7A3A !important;
    border-style: dashed !important;
    background-color: rgba(45, 122, 58, 0.08) !important;
    animation: pulse-lunch 1.2s ease-in-out infinite;
  }
  body.dragging-extras .drop-zone[data-meal="extras"] {
    border-color: #8E44AD !important;
    border-style: dashed !important;
    background-color: rgba(142, 68, 173, 0.08) !important;
    animation: pulse-extras 1.2s ease-in-out infinite;
  }
  @keyframes pulse-tiffin {
    0%, 100% { box-shadow: 0 0 0 0 rgba(232, 163, 23, 0); }
    50% { box-shadow: 0 0 0 3px rgba(232, 163, 23, 0.2); }
  }
  @keyframes pulse-lunch {
    0%, 100% { box-shadow: 0 0 0 0 rgba(45, 122, 58, 0); }
    50% { box-shadow: 0 0 0 3px rgba(45, 122, 58, 0.2); }
  }
  @keyframes pulse-extras {
    0%, 100% { box-shadow: 0 0 0 0 rgba(142, 68, 173, 0); }
    50% { box-shadow: 0 0 0 3px rgba(142, 68, 173, 0.2); }
  }
  .drop-zone.drag-over-extras {
    background-color: rgba(142, 68, 173, 0.15) !important;
    border-color: #8E44AD !important;
    border-style: solid !important;
    box-shadow: inset 0 0 0 2px rgba(142, 68, 173, 0.3) !important;
  }
  #drag-ghost {
    position: fixed;
    top: -1000px;
    left: -1000px;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script define:vars={{ recipeMap, base, plannerJson, foodsData: foods }}>
  window.__RECIPE_MAP = recipeMap;
  window.__BASE = base;
  window.__PLANNER = plannerJson;
  window.__FOODS = foodsData;
</script>

<script>
  const recipeMap = window.__RECIPE_MAP;
  const imgBase = window.__BASE + 'images/recipes/';
  const allFoods = window.__FOODS;
  const PANTRY_ID = '256b1a74-c6c8-4e07-822e-94dd8c997512';
  const PANTRY_BASKET = 'planner';
  const PANTRY_URL = `https://getpantry.cloud/apiv1/pantry/${PANTRY_ID}/basket/${PANTRY_BASKET}`;
  let plannerData = JSON.parse(JSON.stringify(window.__PLANNER));
  let modified = false;

  // Load from Pantry cloud (async, re-renders when ready)
  (async () => {
    try {
      const res = await fetch(PANTRY_URL);
      if (res.ok) {
        const cloud = await res.json();
        if (cloud && Object.keys(cloud).length) {
          plannerData = cloud;
        }
      }
    } catch (e) {
      console.warn('Pantry load failed, using local data', e);
    } finally {
      document.getElementById('planner-loading').classList.add('hidden');
      document.getElementById('week-header').classList.remove('hidden');
      document.getElementById('planner-layout').classList.remove('hidden');
      render();
      renderComboList();
    }
  })();

  // SVG icon strings
  const icons = {
    sun: '<svg class="w-4 h-4 text-[#E8A317]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>',
    rice: '<svg class="w-4 h-4 text-[#2D7A3A]" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a6 6 0 00-6 6c0 3.3 2.7 6 6 6s6-2.7 6-6a6 6 0 00-6-6zm0 14c-1 0-3 .5-3 2h6c0-1.5-2-2-3-2z"/></svg>',
    moon: '<svg class="w-4 h-4 text-[#D35400]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>',
    star: '<svg class="w-4 h-4 text-[#8E44AD]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>',
    clear: '<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>',
    rotate: '<svg class="w-3 h-3 inline" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>',
  };

  // Drag ghost element
  const dragGhost = document.createElement('div');
  dragGhost.id = 'drag-ghost';
  document.body.appendChild(dragGhost);

  function setDragGhost(e, mainId, name) {
    dragGhost.innerHTML = `<div style="width:160px;height:40px" class="flex items-center gap-2 rounded-lg bg-white border border-mist shadow-lg px-2 py-1 overflow-hidden">
      <img src="${imgBase}${mainId}.jpg" style="width:32px;height:32px" class="rounded object-cover flex-shrink-0" onerror="this.style.display='none'" />
      <span class="text-xs font-bold text-bark truncate">${name}</span>
    </div>`;
    e.dataTransfer.setDragImage(dragGhost, 80, 20);
  }

  // State
  let weekStart = getMonday(new Date());
  let activeTab = 'tiffin';
  let activeSlot = null;

  function getMonday(d) {
    const dt = new Date(d);
    const day = dt.getDay();
    const diff = dt.getDate() - day + (day === 0 ? -6 : 1);
    return new Date(dt.setDate(diff));
  }

  function fmtDate(d) { return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
  function rName(id) { return recipeMap[id]?.name_en || id; }

  function getWeekDays() {
    const days = [];
    for (let i = 0; i < 7; i++) {
      const d = new Date(weekStart);
      d.setDate(d.getDate() + i);
      days.push(d);
    }
    return days;
  }

  function getDayData(dateStr) {
    const month = dateStr.substring(0, 7);
    return plannerData[month]?.[dateStr] || null;
  }

  function setDayData(dateStr, data) {
    const month = dateStr.substring(0, 7);
    if (!plannerData[month]) plannerData[month] = {};
    if (data && Object.keys(data).length) {
      plannerData[month][dateStr] = data;
    } else {
      delete plannerData[month][dateStr];
    }
    modified = true;
  }

  // ---- History Tracking ----
  function getFoodHistory() {
    // Returns { foodId: { count, lastDate } } for all assigned foods
    const history = {};
    Object.entries(plannerData).forEach(([month, days]) => {
      Object.entries(days).forEach(([dateStr, data]) => {
        if (!data || typeof data !== 'object' || dateStr.startsWith('_')) return;
        for (const slot of ['breakfast', 'lunch', 'dinner']) {
          const fid = data[slot];
          if (!fid) continue;
          if (!history[fid]) history[fid] = { count: 0, lastDate: null };
          history[fid].count++;
          if (!history[fid].lastDate || dateStr > history[fid].lastDate) {
            history[fid].lastDate = dateStr;
          }
        }
        // Extras is an array
        const extrasArr = Array.isArray(data.extras) ? data.extras : (data.extras ? [data.extras] : []);
        extrasArr.forEach(fid => {
          if (!history[fid]) history[fid] = { count: 0, lastDate: null };
          history[fid].count++;
          if (!history[fid].lastDate || dateStr > history[fid].lastDate) {
            history[fid].lastDate = dateStr;
          }
        });
      });
    });
    return history;
  }

  function daysAgo(dateStr) {
    if (!dateStr) return Infinity;
    const d = new Date(dateStr + 'T00:00:00');
    const now = new Date();
    now.setHours(0, 0, 0, 0);
    return Math.round((now - d) / 86400000);
  }

  function fmtShort(dateStr) {
    const d = new Date(dateStr + 'T00:00:00');
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function fmtAgo(dateStr) {
    if (!dateStr) return '';
    const ago = daysAgo(dateStr);
    if (ago === 0) return 'today';
    if (ago === 1) return 'yesterday';
    if (ago < 7) return `${ago}d ago`;
    if (ago < 30) return `${Math.floor(ago / 7)}w ago`;
    return fmtShort(dateStr);
  }

  // ---- Render ----
  function render() {
    renderWeekTitle();
    renderWeekGrid();
    updateSaveBar();
  }

  function renderWeekTitle() {
    const days = getWeekDays();
    const s = days[0], e = days[6];
    const opts = { month: 'short', day: 'numeric' };
    document.getElementById('week-title').textContent = `${s.toLocaleDateString('en-US', opts)} — ${e.toLocaleDateString('en-US', opts)}, ${e.getFullYear()}`;
  }

  function renderWeekGrid() {
    const days = getWeekDays();
    const today = fmtDate(new Date());
    const dayNames = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    const meals = [
      { key: 'breakfast', icon: icons.sun, label: 'BF', color: '#E8A317' },
      { key: 'lunch', icon: icons.rice, label: 'Lunch', color: '#2D7A3A' },
      { key: 'dinner', icon: icons.moon, label: 'Dinner', color: '#D35400' },
      { key: 'extras', icon: icons.star, label: 'Extras', color: '#8E44AD' },
    ];

    let html = `<thead><tr>
      <th class="text-[10px] font-bold text-stone uppercase px-1 py-1.5 text-left" style="width:60px">Day</th>
      ${meals.map(m => `<th class="text-[10px] font-bold text-stone uppercase px-1 py-1.5 text-center">
        <span class="inline-flex items-center gap-1">${m.icon} ${m.label}</span>
      </th>`).join('')}
    </tr></thead><tbody>`;

    days.forEach((d, i) => {
      const dateStr = fmtDate(d);
      const data = getDayData(dateStr);
      const isToday = dateStr === today;
      const rowBg = isToday ? 'bg-turmeric-light/40' : (i % 2 === 0 ? 'bg-white' : 'bg-sand/30');
      const todayBadge = isToday ? ' <span class="text-[8px] font-bold text-turmeric uppercase">Today</span>' : '';

      html += `<tr id="day-${dateStr}" class="${rowBg} border-b border-mist/50" style="height:100px">
        <td id="day-header-${dateStr}" class="px-2 py-2 align-middle">
          <span class="text-sm font-bold text-bark">${dayNames[i]}</span>
          <span class="text-xs text-stone ml-1">${d.getDate()}</span>
          ${todayBadge}
        </td>
        ${meals.map(m => {
          const val = data?.[m.key];
          // For extras, pass the array; for others, pass single value
          return `<td id="day-meals-${dateStr}-${m.key}" class="px-1.5 py-1.5 align-top">
            ${m.key === 'extras' ? extrasSlot(dateStr, val, m.icon, m.label, m.color, activeSlot?.day === dateStr && activeSlot?.meal === 'extras') : mealSlot(dateStr, m.key, val, m.icon, m.label, m.color)}
          </td>`;
        }).join('')}
      </tr>`;
    });

    html += '</tbody>';
    document.getElementById('week-grid').innerHTML = html;
    bindSlotEvents();
  }

  function mealSlot(dateStr, meal, foodId, icon, label, color) {
    const food = foodId ? allFoods.find(x => x.id === foodId) : null;
    const isActive = activeSlot?.day === dateStr && activeSlot?.meal === meal;
    const activeRing = isActive ? `ring-2 ring-[${color}]` : '';

    if (!food) {
      return `<div id="slot-${dateStr}-${meal}" class="drop-zone rounded-lg border-2 border-dashed border-mist h-full min-h-[80px] flex items-center justify-center cursor-pointer hover:border-[${color}]/50 hover:bg-[${color}]/5 transition-all ${activeRing}"
        data-slot="${dateStr}|${meal}" data-meal="${meal}">
        <span class="text-sm text-smoke/40 font-medium">+</span>
      </div>`;
    }

    const mainName = recipeMap[food.main]?.name_en || food.main;
    const mainTa = recipeMap[food.main]?.name_ta || '';
    const sideNames = food.sides.map(s => recipeMap[s]?.name_en || s).join(', ');
    const sideTa = food.sides.map(s => recipeMap[s]?.name_ta || '').filter(Boolean).join(', ');
    const mainImg = `${imgBase}${food.main}.jpg`;
    const sideThumbs = food.sides.map(s => `<img src="${imgBase}${s}.jpg" alt="" class="w-7 h-7 rounded object-cover flex-shrink-0 border border-white" onerror="this.style.display='none'" />`).join('');

    return `<div id="slot-${dateStr}-${meal}" class="drop-zone assigned-drag rounded-lg border border-[${color}]/30 bg-[${color}]/5 h-full min-h-[80px] px-2.5 py-2 cursor-grab active:cursor-grabbing ${activeRing} group"
      data-slot="${dateStr}|${meal}" data-meal="${meal}" data-food="${foodId}" draggable="true">
      <div class="flex items-start gap-2 h-full">
        <div class="flex -space-x-2 flex-shrink-0 pt-0.5">
          <img src="${mainImg}" alt="" class="w-12 h-12 rounded-lg object-cover border-2 border-white relative z-10" onerror="this.style.display='none'" />
          ${sideThumbs}
        </div>
        <div class="flex-1 min-w-0 pt-0.5">
          <p class="text-sm font-bold text-bark leading-snug truncate">${mainName}</p>
          ${mainTa ? `<p class="text-xs text-stone/70 font-tamil leading-snug truncate">${mainTa}</p>` : ''}
          ${sideNames ? `<p class="text-xs text-stone leading-snug truncate mt-0.5">${sideNames}</p>` : ''}
          ${sideTa ? `<p class="text-xs text-stone/70 font-tamil leading-snug truncate">${sideTa}</p>` : ''}
        </div>
        <button data-clear="${dateStr}|${meal}" class="opacity-0 group-hover:opacity-100 text-smoke hover:text-clay cursor-pointer p-0.5 transition-opacity flex-shrink-0">
          ${icons.clear}
        </button>
      </div>
    </div>`;
  }

  function extrasSlot(dateStr, extrasData, icon, label, color, isActive) {
    const arr = Array.isArray(extrasData) ? extrasData : (extrasData ? [extrasData] : []);
    const activeRing = isActive ? `ring-2 ring-[${color}]` : '';

    // Always show the drop zone container
    let itemsHtml = '';
    arr.forEach((fid, idx) => {
      const food = allFoods.find(x => x.id === fid);
      if (!food) return;
      const name = recipeMap[food.main]?.name_en || food.main;
      const nameTa = recipeMap[food.main]?.name_ta || '';
      itemsHtml += `<div class="flex items-center gap-1.5 group/item">
        <img src="${imgBase}${food.main}.jpg" alt="" class="w-8 h-8 rounded-md object-cover flex-shrink-0" onerror="this.style.display='none'" />
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-bark leading-tight truncate">${name}</p>
          ${nameTa ? `<p class="text-[10px] text-stone/70 font-tamil leading-tight truncate">${nameTa}</p>` : ''}
        </div>
        <button data-clear-extra="${dateStr}|${idx}" class="opacity-0 group-hover/item:opacity-100 text-smoke hover:text-clay cursor-pointer p-0.5 transition-opacity flex-shrink-0">
          ${icons.clear}
        </button>
      </div>`;
    });

    return `<div id="slot-${dateStr}-extras" class="drop-zone rounded-lg border-2 ${arr.length ? 'border-[' + color + ']/30 bg-[' + color + ']/5 border-solid' : 'border-dashed border-mist'} h-full min-h-[80px] px-2 py-1.5 cursor-pointer hover:border-[${color}]/50 hover:bg-[${color}]/5 transition-all ${activeRing}"
      data-slot="${dateStr}|extras" data-meal="extras">
      ${itemsHtml ? `<div class="space-y-1.5">${itemsHtml}</div>` : '<div class="h-full flex items-center justify-center"><span class="text-sm text-smoke/40 font-medium">+</span></div>'}
    </div>`;
  }

  function bindSlotEvents() {
    // Click empty slots to select
    document.querySelectorAll('[data-slot]').forEach(el => {
      el.addEventListener('click', (e) => {
        if (e.target.closest('[data-clear]')) return;
        const [dateStr, meal] = el.dataset.slot.split('|');
        setActiveSlot(dateStr, meal);
      });
    });

    // Clear buttons
    document.querySelectorAll('[data-clear]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const [dateStr, meal] = el.dataset.clear.split('|');
        const data = getDayData(dateStr);
        if (data) {
          delete data[meal];
          setDayData(dateStr, data);
          render();
        }
      });
    });

    // Clear individual extras
    document.querySelectorAll('[data-clear-extra]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const [dateStr, idxStr] = el.dataset.clearExtra.split('|');
        const idx = parseInt(idxStr);
        const data = getDayData(dateStr);
        if (data && Array.isArray(data.extras)) {
          data.extras.splice(idx, 1);
          if (!data.extras.length) delete data.extras;
          setDayData(dateStr, data);
          render();
        }
      });
    });

    // --- Drag: assigned items (for swap) ---
    document.querySelectorAll('.assigned-drag').forEach(el => {
      el.addEventListener('dragstart', (e) => {
        const foodId = el.dataset.food;
        const food = allFoods.find(x => x.id === foodId);
        const mainId = food ? food.main : foodId;
        const mainName = food ? (recipeMap[food.main]?.name_en || food.main) : foodId;
        setDragGhost(e, mainId, mainName);
        e.dataTransfer.setData('text/plain', JSON.stringify({
          type: 'assigned',
          slot: el.dataset.slot,
          foodId: foodId,
          meal: el.dataset.meal,
        }));
        e.dataTransfer.effectAllowed = 'move';
        el.classList.add('dragging');
        document.body.classList.add(el.dataset.meal === 'lunch' ? 'dragging-lunch' : el.dataset.meal === 'extras' ? 'dragging-extras' : 'dragging-tiffin');
      });
      el.addEventListener('dragend', () => {
        el.classList.remove('dragging');
        document.body.classList.remove('dragging-tiffin', 'dragging-lunch', 'dragging-extras');
      });
    });

    // --- Drop zones ---
    document.querySelectorAll('.drop-zone').forEach(zone => {
      zone.addEventListener('dragover', (e) => {
        e.preventDefault();
        const meal = zone.dataset.meal;
        zone.classList.add(meal === 'lunch' ? 'drag-over-lunch' : meal === 'extras' ? 'drag-over-extras' : 'drag-over');
      });
      zone.addEventListener('dragleave', () => {
        zone.classList.remove('drag-over', 'drag-over-lunch', 'drag-over-extras');
      });
      zone.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('drag-over', 'drag-over-lunch', 'drag-over-extras');
        const raw = e.dataTransfer.getData('text/plain');
        if (!raw) return;
        let payload;
        try { payload = JSON.parse(raw); } catch { return; }

        const [targetDate, targetMeal] = zone.dataset.slot.split('|');

        if (payload.type === 'combo') {
          // From suggestion panel
          const food = allFoods.find(x => x.id === payload.foodId);
          if (!food) return;
          if (targetMeal === 'lunch' && food.category !== 'lunch') { showToast('Lunch combos only'); return; }
          if ((targetMeal === 'breakfast' || targetMeal === 'dinner') && food.category !== 'tiffin') { showToast('Tiffin combos only'); return; }
          if (targetMeal === 'extras' && food.category !== 'extras') { showToast('Extras only'); return; }
          const data = getDayData(targetDate) || {};
          if (targetMeal === 'extras') {
            // Append to extras array
            const arr = Array.isArray(data.extras) ? data.extras : (data.extras ? [data.extras] : []);
            if (arr.includes(payload.foodId)) { showToast('Already added'); return; }
            arr.push(payload.foodId);
            data.extras = arr;
          } else {
            data[targetMeal] = payload.foodId;
          }
          setDayData(targetDate, data);
          showToast(`${food.name_en} assigned`);
        } else if (payload.type === 'assigned') {
          // From another slot — swap
          const [srcDate, srcMeal] = payload.slot.split('|');
          if ((srcMeal === 'lunch') !== (targetMeal === 'lunch') || (srcMeal === 'extras') !== (targetMeal === 'extras')) { showToast("Can't swap different meal types"); return; }
          const srcData = getDayData(srcDate) || {};
          const tgtData = (srcDate === targetDate) ? srcData : (getDayData(targetDate) || {});
          const srcFood = srcData[srcMeal];
          const tgtFood = tgtData[targetMeal];
          if (srcFood) tgtData[targetMeal] = srcFood; else delete tgtData[targetMeal];
          if (tgtFood) srcData[srcMeal] = tgtFood; else delete srcData[srcMeal];
          setDayData(srcDate, srcData);
          if (srcDate !== targetDate) setDayData(targetDate, tgtData);
          showToast('Swapped');
        }
        render();
      });
    });
  }

  function setActiveSlot(dateStr, meal) {
    activeSlot = { day: dateStr, meal };
    if (meal === 'lunch') activeTab = 'lunch';
    else if (meal === 'extras') activeTab = 'extras';
    else activeTab = 'tiffin';
    render();
  }

  // ---- Left Panel ----
  function groupByMain(foods) {
    const groups = {};
    foods.forEach(f => {
      if (!groups[f.main]) groups[f.main] = [];
      groups[f.main].push(f);
    });
    return Object.entries(groups);
  }

  function renderComboList() {
    updateTabStyles();
    const container = document.getElementById('combo-list');
    const rotInfo = document.getElementById('rotation-info');
    const history = getFoodHistory();
    const cat = activeTab;
    const color = cat === 'tiffin' ? '#E8A317' : cat === 'lunch' ? '#2D7A3A' : '#8E44AD';
    const foods = allFoods.filter(f => f.category === cat);
    const neverCooked = foods.filter(f => !history[f.id]);
    rotInfo.innerHTML = `${icons.rotate} ${foods.length} combos &middot; <span class="text-leaf font-semibold">${neverCooked.length} never cooked</span>`;

    // Group by main, sort groups by least-recently-cooked combo in group
    const groups = groupByMain(foods);
    groups.sort((a, b) => {
      const bestA = Math.max(...a[1].map(f => history[f.id] ? daysAgo(history[f.id].lastDate) : Infinity));
      const bestB = Math.max(...b[1].map(f => history[f.id] ? daysAgo(history[f.id].lastDate) : Infinity));
      return bestB - bestA;
    });

    let html = '';

    if (cat === 'extras') {
      // Group extras by subcategory
      const subLabels = { 'snacks/items': 'Snacks', 'desserts/items': 'Desserts', 'accompaniments/items': 'Accompaniments' };
      const subOrder = ['snacks/items', 'desserts/items', 'accompaniments/items'];
      const bySub = {};
      foods.forEach(f => {
        const s = recipeMap[f.main]?.category || 'snacks/items';
        if (!bySub[s]) bySub[s] = [];
        bySub[s].push(f);
      });

      subOrder.forEach(sub => {
        const items = bySub[sub];
        if (!items || !items.length) return;

        // Sort within sub: never cooked first, then oldest
        const sorted = [...items].sort((a, b) => {
          const ha = history[a.id], hb = history[b.id];
          const da = ha ? daysAgo(ha.lastDate) : Infinity;
          const db = hb ? daysAgo(hb.lastDate) : Infinity;
          return db === da ? (ha?.count || 0) - (hb?.count || 0) : db - da;
        });

        html += `<div class="mb-3 combo-group" data-main-name="${sub}">
          <div class="text-xs font-bold text-bark uppercase tracking-wide px-1 mb-2">${subLabels[sub]} <span class="text-stone font-normal">(${items.length})</span></div>
          <div class="space-y-1.5">`;

        sorted.forEach(f => {
          const h = history[f.id];
          const name = recipeMap[f.main]?.name_en || f.main;
          const nameTa = recipeMap[f.main]?.name_ta || '';

          let badge = '';
          if (!h) {
            badge = `<span class="text-xs text-leaf font-semibold flex-shrink-0">New</span>`;
          } else {
            badge = `<span class="text-xs text-stone font-medium flex-shrink-0">${h.count}x &middot; ${fmtAgo(h.lastDate)}</span>`;
          }

          html += `<div data-assign="${f.id}" draggable="true" data-main-name="${name.toLowerCase()}" data-main-ta="${nameTa.toLowerCase()}" class="combo-drag-item rounded-lg border border-mist bg-white px-3.5 py-2.5 cursor-grab active:cursor-grabbing hover:border-[${color}] hover:bg-[${color}]/5 transition-colors flex gap-3 items-center select-none">
            <img src="${imgBase}${f.main}.jpg" alt="" class="w-10 h-10 rounded-lg object-cover flex-shrink-0" onerror="this.style.display='none'" />
            <div class="min-w-0 flex-1">
              <span class="text-sm font-semibold text-bark truncate block">${name}</span>
              ${nameTa ? `<span class="text-xs text-stone font-tamil truncate block">${nameTa}</span>` : ''}
            </div>
            ${badge}
          </div>`;
        });

        html += `</div></div>`;
      });
    } else {
      // Grouped view for tiffin/lunch
    groups.forEach(([mainId, combos]) => {
      const mainName = recipeMap[mainId]?.name_en || mainId;
      const mainTa = recipeMap[mainId]?.name_ta || '';

      html += `<div id="group-${mainId}" class="mb-4 combo-group rounded-xl border border-mist bg-white shadow-sm overflow-hidden" data-main-name="${mainName.toLowerCase()}" data-main-ta="${mainTa.toLowerCase()}">
        <div id="group-header-${mainId}" class="flex items-center gap-3 px-3 py-2.5 bg-sand/40 border-b border-mist">
          <img src="${imgBase}${mainId}.jpg" alt="" class="w-11 h-11 rounded-lg object-cover flex-shrink-0" onerror="this.style.display='none'" />
          <div class="min-w-0">
            <span class="text-base font-bold text-bark truncate block">${mainName}</span>
            <span class="text-xs text-stone font-tamil truncate block">${mainTa}</span>
          </div>
        </div>
        <div id="group-items-${mainId}" class="space-y-1.5 p-2.5">`;

      // Sort combos within group: never cooked first, then oldest
      const sorted = [...combos].sort((a, b) => {
        const ha = history[a.id], hb = history[b.id];
        const da = ha ? daysAgo(ha.lastDate) : Infinity;
        const db = hb ? daysAgo(hb.lastDate) : Infinity;
        return db === da ? (ha?.count || 0) - (hb?.count || 0) : db - da;
      });

      sorted.forEach(f => {
        const h = history[f.id];
        const sideNames = f.sides.map(s => recipeMap[s]?.name_en || s).join(', ');
        const sideTa = f.sides.map(s => recipeMap[s]?.name_ta || '').filter(Boolean).join(', ');
        const sideThumbs = f.sides.map(s => `<img src="${imgBase}${s}.jpg" alt="" class="w-8 h-8 rounded-md object-cover flex-shrink-0" onerror="this.style.display='none'">`).join('');

        let badge = '';
        if (!h) {
          badge = `<span class="text-xs text-leaf font-semibold flex-shrink-0">New</span>`;
        } else {
          badge = `<span class="text-xs text-stone font-medium flex-shrink-0">${h.count}x &middot; ${fmtAgo(h.lastDate)}</span>`;
        }

        html += `<div data-assign="${f.id}" draggable="true" data-sides="${sideNames.toLowerCase()}" data-sides-ta="${(sideTa||'').toLowerCase()}" class="combo-drag-item rounded-lg border border-mist bg-white px-3.5 py-2.5 cursor-grab active:cursor-grabbing hover:border-[${color}] hover:bg-[${color}]/5 transition-colors flex gap-3 items-center select-none">
          ${sideThumbs}
          <div class="min-w-0 flex-1">
            <span class="text-sm text-bark truncate block">${sideNames || 'No side'}</span>
            ${sideTa ? `<span class="text-xs text-stone font-tamil truncate block">${sideTa}</span>` : ''}
          </div>
          ${badge}
        </div>`;
      });

      html += `</div></div>`;
    });
    }

    container.innerHTML = html;

    // Click to assign
    container.querySelectorAll('[data-assign]').forEach(el => {
      el.addEventListener('click', () => {
        if (!activeSlot) { showToast('Click a meal slot first'); return; }
        assignToSlot(el.dataset.assign);
      });
      // Drag from combo list
      el.addEventListener('dragstart', (e) => {
        const foodId = el.dataset.assign;
        const food = allFoods.find(x => x.id === foodId);
        const mainId = food ? food.main : foodId;
        const mainName = food ? (recipeMap[food.main]?.name_en || food.main) : foodId;
        setDragGhost(e, mainId, mainName);
        e.dataTransfer.setData('text/plain', JSON.stringify({
          type: 'combo',
          foodId: foodId,
        }));
        e.dataTransfer.effectAllowed = 'copyMove';
        el.classList.add('dragging');
        document.body.classList.add(food?.category === 'lunch' ? 'dragging-lunch' : food?.category === 'extras' ? 'dragging-extras' : 'dragging-tiffin');
      });
      el.addEventListener('dragend', () => {
        el.classList.remove('dragging');
        document.body.classList.remove('dragging-tiffin', 'dragging-lunch', 'dragging-extras');
      });
    });
  }

  function assignToSlot(foodId) {
    const food = allFoods.find(x => x.id === foodId);
    if (!food) return;
    if (activeSlot.meal === 'lunch' && food.category !== 'lunch') { showToast('Lunch combos only'); return; }
    if ((activeSlot.meal === 'breakfast' || activeSlot.meal === 'dinner') && food.category !== 'tiffin') { showToast('Tiffin combos only'); return; }
    if (activeSlot.meal === 'extras' && food.category !== 'extras') { showToast('Extras only'); return; }
    const data = getDayData(activeSlot.day) || {};
    if (activeSlot.meal === 'extras') {
      const arr = Array.isArray(data.extras) ? data.extras : (data.extras ? [data.extras] : []);
      if (arr.includes(foodId)) { showToast('Already added'); return; }
      arr.push(foodId);
      data.extras = arr;
    } else {
      data[activeSlot.meal] = foodId;
    }
    setDayData(activeSlot.day, data);
    showToast(`${food.name_en} assigned`);
    render();
  }

  // ---- Auto-Assign (prefer least recently cooked) ----
  function autoAssign() {
    const days = getWeekDays();
    const history = getFoodHistory();

    // Sort by: never cooked first, then oldest-last-cooked, with shuffle tiebreak
    function sortByLeastRecent(foods) {
      return shuffle([...foods]).sort((a, b) => {
        const ha = history[a.id], hb = history[b.id];
        if (!ha && !hb) return 0;
        if (!ha) return -1;
        if (!hb) return 1;
        const da = daysAgo(ha.lastDate), db = daysAgo(hb.lastDate);
        return db === da ? ha.count - hb.count : db - da;
      });
    }

    const tiffinSorted = sortByLeastRecent(allFoods.filter(f => f.category === 'tiffin'));
    const lunchSorted = sortByLeastRecent(allFoods.filter(f => f.category === 'lunch'));
    const extrasSorted = sortByLeastRecent(allFoods.filter(f => f.category === 'extras'));

    let tIdx = 0, lIdx = 0, eIdx = 0, count = 0;

    days.forEach(d => {
      const dateStr = fmtDate(d);
      const data = getDayData(dateStr) || {};

      if (!data.breakfast && tIdx < tiffinSorted.length) {
        data.breakfast = tiffinSorted[tIdx++].id;
        count++;
      }
      if (!data.lunch && lIdx < lunchSorted.length) {
        data.lunch = lunchSorted[lIdx++].id;
        count++;
      }
      if (!data.dinner && tIdx < tiffinSorted.length) {
        data.dinner = tiffinSorted[tIdx++].id;
        count++;
      }
      if ((!data.extras || !data.extras.length) && eIdx < extrasSorted.length) {
        data.extras = [extrasSorted[eIdx++].id];
        count++;
      }

      if (Object.keys(data).length) setDayData(dateStr, data);
    });

    showToast(count ? `Auto-filled ${count} slots` : 'All slots filled or no combos available');
    render();
  }

  function clearWeek() {
    if (!confirm('Clear all meals for this week?')) return;
    const days = getWeekDays();
    let count = 0;
    days.forEach(d => {
      const dateStr = fmtDate(d);
      if (getDayData(dateStr)) {
        setDayData(dateStr, null);
        count++;
      }
    });
    showToast(count ? `Cleared ${count} day(s)` : 'Week already empty');
    render();
  }

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function updateTabStyles() {
    const tBtn = document.getElementById('tab-tiffin');
    const lBtn = document.getElementById('tab-lunch');
    const eBtn = document.getElementById('tab-extras');
    const active = 'flex-1 rounded-md text-xs font-bold py-2 cursor-pointer bg-white text-bark shadow-sm';
    const inactive = 'flex-1 rounded-md text-xs font-bold py-2 cursor-pointer text-stone';
    tBtn.className = activeTab === 'tiffin' ? active : inactive;
    lBtn.className = activeTab === 'lunch' ? active : inactive;
    eBtn.className = activeTab === 'extras' ? active : inactive;
  }

  // ---- Save / Export ----
  function updateSaveBar() {
    document.getElementById('export-planner').classList.toggle('hidden', !modified);
  }

  async function exportPlanner() {
    const btn = document.getElementById('export-planner');
    btn.textContent = 'Saving...';
    btn.disabled = true;
    try {
      const res = await fetch(PANTRY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(plannerData),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      modified = false;
      updateSaveBar();
      showToast('Saved to cloud');
    } catch (e) {
      console.error('Pantry save failed', e);
      showToast('Save failed — check console');
    } finally {
      btn.textContent = 'Save';
      btn.disabled = false;
    }
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.remove('hidden');
    requestAnimationFrame(() => { t.style.opacity = '1'; });
    clearTimeout(t._tid);
    t._tid = setTimeout(() => {
      t.style.opacity = '0';
      setTimeout(() => t.classList.add('hidden'), 300);
    }, 2500);
  }

  // ---- Init ----
  document.getElementById('prev-week').addEventListener('click', () => {
    weekStart.setDate(weekStart.getDate() - 7);
    weekStart = new Date(weekStart);
    render();
  });
  document.getElementById('next-week').addEventListener('click', () => {
    weekStart.setDate(weekStart.getDate() + 7);
    weekStart = new Date(weekStart);
    render();
  });
  document.getElementById('today-btn').addEventListener('click', () => {
    weekStart = getMonday(new Date());
    render();
  });
  document.getElementById('tab-tiffin').addEventListener('click', () => { activeTab = 'tiffin'; document.getElementById('combo-filter').value = ''; renderComboList(); });
  document.getElementById('tab-lunch').addEventListener('click', () => { activeTab = 'lunch'; document.getElementById('combo-filter').value = ''; renderComboList(); });
  document.getElementById('tab-extras').addEventListener('click', () => { activeTab = 'extras'; document.getElementById('combo-filter').value = ''; renderComboList(); });
  document.getElementById('combo-filter').addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('#combo-list .combo-group').forEach(group => {
      const mainName = group.dataset.mainName || '';
      const mainTa = group.dataset.mainTa || '';
      const mainMatch = mainName.includes(q) || mainTa.includes(q);
      let anyComboVisible = false;
      group.querySelectorAll('[data-assign]').forEach(item => {
        const sides = item.dataset.sides || '';
        const sidesTa = item.dataset.sidesTa || '';
        const visible = !q || mainMatch || sides.includes(q) || sidesTa.includes(q);
        item.style.display = visible ? '' : 'none';
        if (visible) anyComboVisible = true;
      });
      group.style.display = (!q || mainMatch || anyComboVisible) ? '' : 'none';
    });
  });
  document.getElementById('export-planner').addEventListener('click', exportPlanner);
  document.getElementById('auto-assign-btn').addEventListener('click', autoAssign);
  document.getElementById('clear-week-btn').addEventListener('click', clearWeek);
</script>
